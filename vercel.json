      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "trikaalvaani.org" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.trikaalvaani.org" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    }
  ]
