{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/panchang-generate",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron/festival-generate",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/push/daily?slot=morning",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/push/daily?slot=evening",
      "schedule": "30 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "trikaalvaani.in" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.trikaalvaani.in" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "trikalvaani.in" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.trikalvaani.in" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "trikaalvaani.org" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.trikaalvaani.org" }],
