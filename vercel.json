{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/panchang-generate",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/push/daily?slot=festival",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/push/daily?slot=muhurat",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/push/daily?slot=rashifal",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/push/daily?slot=panchang",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/push/daily?slot=cta",
      "schedule": "30 15 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "trikaalvaani.in" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.trikaalvaani.in" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "trikalvaani.in" }],
      "destination": "https://trikalvaani.com/$1",
      "permanent": true
