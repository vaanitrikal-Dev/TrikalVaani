/**
 * Trikaal Vaani — Blog body_content updater
 * Run: node update-blog-content.js
 * Requires: NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in .env.local
 * Place the 5 .md files in the same folder as this script, then run.
 */

const fs = require('fs');
const path = require('path');
require('dotenv').config({ path: '.env.local' });

const SUPABASE_URL = process.env.NEXT_PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;

if (!SUPABASE_URL || !SUPABASE_KEY) {
  console.error('❌ Missing NEXT_PUBLIC_SUPABASE_URL or NEXT_PUBLIC_SUPABASE_ANON_KEY in .env.local');
  process.exit(1);
}

const BLOGS = [
  { slug: 'what-is-rahu',              file: 'blog-what-is-rahu.md' },
  { slug: 'what-is-ketu',              file: 'blog-what-is-ketu.md' },
  { slug: 'what-is-mangal-dosha',      file: 'blog-what-is-mangal-dosha.md' },
  { slug: 'manglik-marriage-dangerous',file: 'blog-manglik-marriage-dangerous.md' },
  { slug: 'saturn-transit-2026',       file: 'blog-saturn-transit-2026.md' },
];

async function updateBlog(slug, content) {
  const url = `${SUPABASE_URL}/rest/v1/seo_pillar_pages?slug=eq.${slug}`;
  const res = await fetch(url, {
    method: 'PATCH',
    headers: {
      'apikey': SUPABASE_KEY,
      'Authorization': `Bearer ${SUPABASE_KEY}`,
      'Content-Type': 'application/json',
      'Prefer': 'return=minimal',
    },
    body: JSON.stringify({
      body_content: content,
      updated_at: new Date().toISOString(),
    }),
  });

  if (!res.ok) {
    const err = await res.text();
    console.error(`❌ ${slug}: HTTP ${res.status} — ${err}`);
    return false;
  }
  return true;
}

async function main() {
  console.log('🔱 Trikaal Vaani — Blog content updater\n');

  for (const { slug, file } of BLOGS) {
    const filePath = path.join(__dirname, file);

    if (!fs.existsSync(filePath)) {
      console.warn(`⚠️  Skipping ${slug} — file not found: ${file}`);
      continue;
    }

    const content = fs.readFileSync(filePath, 'utf8');
    const wordCount = content.split(/\s+/).length;
    process.stdout.write(`Updating ${slug} (${wordCount} words)... `);

    const ok = await updateBlog(slug, content);
    if (ok) {
      console.log('✅ Done');
    }
  }

  console.log('\n🔱 All done. Verify at https://trikalvaani.com/learn/');
}

main().catch(console.error);
